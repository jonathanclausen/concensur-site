---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { projectImage } from '../lib/images';
import type { CaseStudy } from '../data/i18n';

interface Props {
  project: Project;
  /** Localised texts (falls back to the Danish project texts). */
  text?: CaseStudy;
  readMore: string;
  headingLevel?: 'h2' | 'h3';
}
const { project, text = project, readMore, headingLevel: H = 'h3' } = Astro.props;
const img = projectImage(project.image);
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-violet-500/10 dark:border-white/10 dark:bg-white/[0.03]">
  <div class="aspect-[4/3] overflow-hidden bg-gradient-to-br from-violet-100 to-cyan-100 dark:from-violet-950 dark:to-cyan-950">
    {img ? (
      <Image src={img} alt={`Skærmbillede af ${project.company}s hjemmeside`} widths={[400, 640, 960]} sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
             class="size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
    ) : (
      <div class="grid size-full place-items-center font-display text-2xl font-bold text-violet-700/60 dark:text-violet-300/50" aria-hidden="true">{project.company}</div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">{text.industry} &middot; <time datetime={project.date}>{project.date.slice(0, 4)}</time></p>
    <H class="mt-1 font-display text-lg font-semibold text-slate-900 dark:text-white">
      <a href={`/project/${project.slug}/`} class="after:absolute after:inset-0 focus:outline-none">{project.company}</a>
    </H>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{text.challenge}</p>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Teknologier">
      {text.tags.map((tag) => <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-white/5 dark:text-slate-300">{tag}</li>)}
    </ul>
    <span class="mt-4 text-sm font-semibold text-violet-600 dark:text-violet-400" aria-hidden="true">{readMore} &rarr;</span>
  </div>
</article>
