---
import Base from '../layouts/Base.astro';
---
<Base title="Siden blev ikke fundet | Concensur" description="Siden findes ikke. Gå til forsiden eller bloggen." path="/404/" noindex>
  <div class="mx-auto max-w-2xl px-4 py-28 text-center sm:px-6">
    <p class="font-display text-sm font-semibold uppercase tracking-widest text-violet-600 dark:text-violet-400">404</p>
    <h1 class="mt-2 font-display text-4xl font-bold text-slate-900 dark:text-white">Siden blev ikke fundet</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">Siden er flyttet eller findes ikke længere. / This page could not be found.</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-3 text-sm font-semibold">
      <li><a class="rounded-full bg-gradient-to-r from-violet-600 to-cyan-500 px-6 py-2.5 text-white" href="/">Forside</a></li>
      <li><a class="rounded-full border border-slate-300 px-6 py-2.5 dark:border-white/15" href="/blog/">Blog</a></li>
    </ul>
  </div>
</Base>
