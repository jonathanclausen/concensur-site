---
import { Image } from 'astro:assets';
import { BLOG_POSTS } from '../data/blog';
import { POST_META } from '../data/posts-meta';
import { CATEGORIES } from '../data/categories';
import { blogImage } from '../lib/images';
import { prefix, type Lang } from '../i18n';

interface Props { lang: Lang; slugs?: string[] }
const { lang, slugs } = Astro.props;
const p = prefix(lang);
const posts = BLOG_POSTS[lang]
  .filter((post) => !slugs || slugs.includes(post.slug))
  .sort((a, b) => POST_META[b.slug].published.localeCompare(POST_META[a.slug].published));
const dateFmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'da-DK', { day: 'numeric', month: 'long', year: 'numeric' });
---
<ul class="space-y-6">
  {posts.map((post) => {
    const meta = POST_META[post.slug];
    const img = blogImage(post.slug);
    return (
      <li>
        <article class="group relative grid gap-5 rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:shadow-xl hover:shadow-violet-500/10 sm:grid-cols-[220px_1fr] dark:border-white/10 dark:bg-white/[0.03]">
          {img ? (
            <Image src={img} alt="" widths={[220, 440]} sizes="220px" class="aspect-video w-full rounded-xl object-cover" />
          ) : (
            <div class="hidden aspect-video rounded-xl bg-gradient-to-br from-violet-100 to-cyan-100 sm:block dark:from-violet-950 dark:to-cyan-950" aria-hidden="true"></div>
          )}
          <div>
            <p class="flex flex-wrap gap-x-2 text-xs text-slate-500 dark:text-slate-400">
              <time datetime={meta.published}>{dateFmt.format(new Date(meta.published))}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{lang === 'da' ? meta.categories.map((c) => CATEGORIES[c].name).join(', ') : post.category}</span>
            </p>
            <h2 class="mt-2 font-display text-xl font-semibold text-slate-900 dark:text-white">
              <a href={`${p}/blog/${post.slug}/`} class="after:absolute after:inset-0">{post.title}</a>
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{post.excerpt}</p>
          </div>
        </article>
      </li>
    );
  })}
</ul>
