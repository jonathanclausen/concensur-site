---
import { t, prefix, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  alternates: { lang: Lang; path: string }[];
}
const { lang, alternates } = Astro.props;
const tr = t(lang);
const p = prefix(lang);
const current = Astro.url.pathname;

const links = [
  { href: `${p}/`, label: tr.nav.home, exact: true },
  { href: '/project/', label: lang === 'en' ? 'Cases' : 'Cases', exact: false },
  { href: `${p}/blog/`, label: tr.nav.blog, exact: false },
];
const isActive = (href: string, exact: boolean) => (exact ? current === href : current.startsWith(href));

const daHref = alternates.find((a) => a.lang === 'da')?.path ?? '/';
const enHref = alternates.find((a) => a.lang === 'en')?.path ?? '/en/';
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/75 backdrop-blur-lg transition-colors dark:border-white/10 dark:bg-slate-950/75">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6" aria-label={lang === 'en' ? 'Main' : 'Hovedmenu'}>
    <a href={`${p}/`} class="group flex items-center gap-2.5" aria-label="Concensur">
      <span class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-violet-600 to-cyan-500 font-display text-sm font-bold text-white shadow-lg shadow-violet-500/25 transition-transform group-hover:scale-105" aria-hidden="true">C</span>
      <span class="hidden font-display text-lg font-semibold tracking-tight text-slate-900 min-[420px]:inline dark:text-white">Concensur</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-6">
      <ul class="flex gap-3 text-sm font-medium text-slate-600 sm:gap-6 dark:text-slate-300">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href, l.exact) ? 'page' : undefined}
              class:list={['py-1 transition-colors hover:text-slate-900 dark:hover:text-white', isActive(l.href, l.exact) && 'text-slate-900 dark:text-white']}
            >{l.label}</a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-1">
        <div class="flex items-center rounded-full border border-slate-200 bg-slate-100/70 p-0.5 text-xs font-semibold text-slate-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          <a href={daHref} hreflang="da" lang="da" aria-label="Dansk" aria-current={lang === 'da' ? 'true' : undefined}
             class:list={['rounded-full px-2.5 py-1 transition-all', lang === 'da' && 'bg-white text-slate-900 shadow-sm dark:bg-white/10 dark:text-white']}>DA</a>
          <a href={enHref} hreflang="en" lang="en" aria-label="English" aria-current={lang === 'en' ? 'true' : undefined}
             class:list={['rounded-full px-2.5 py-1 transition-all', lang === 'en' && 'bg-white text-slate-900 shadow-sm dark:bg-white/10 dark:text-white']}>EN</a>
        </div>
        <button type="button" data-theme-toggle
                class="rounded-full p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white"
                aria-label={lang === 'en' ? 'Toggle dark mode' : 'Skift mellem lyst og mørkt tema'}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden size-4.5 dark:block" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="block size-4.5 dark:hidden" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('concensur-theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>
