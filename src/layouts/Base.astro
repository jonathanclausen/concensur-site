---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import portrait from '../assets/jonathan-clausen.jpg';
import { SITE } from '../data/site';
import type { Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Path of this page, e.g. "/blog/". Used for canonical and og:url. */
  path: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Same page in other languages, for hreflang. */
  alternates?: { lang: Lang; path: string }[];
  jsonLd?: Record<string, unknown>[];
  published?: string;
  modified?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'da',
  path,
  image = portrait,
  imageAlt = SITE.person,
  type = 'website',
  alternates = [],
  jsonLd = [],
  published,
  modified,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const og = await getImage({ src: image, width: 1200, format: 'jpeg' });
const ogUrl = new URL(og.src, SITE.url).href;
const hreflang = { da: 'da', en: 'en' } as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {alternates.length > 0 && alternates.map((a) => <link rel="alternate" hreflang={hreflang[a.lang]} href={new URL(a.path, SITE.url).href} />)}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.lang === 'da')?.path ?? path, SITE.url).href} />
    )}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'da_DK'} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? '')} />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Concensur blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#7c3aed" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('concensur-theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-white text-slate-900 antialiased transition-colors dark:bg-slate-950 dark:text-slate-100 font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-violet-600 focus:px-4 focus:py-2 focus:text-white">
      {lang === 'en' ? 'Skip to content' : 'Spring til indhold'}
    </a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
