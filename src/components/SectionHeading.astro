---
interface Props { eyebrow: string; title: string; id?: string }
const { eyebrow, title, id } = Astro.props;
---
<div class="mb-12 text-center">
  <p class="font-display text-sm font-semibold uppercase tracking-widest text-violet-600 dark:text-violet-400">{eyebrow}</p>
  <h2 id={id} class="mt-2 font-display text-3xl font-bold text-slate-900 dark:text-white">{title}</h2>
</div>
