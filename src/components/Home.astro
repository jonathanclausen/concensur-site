---
import { Image } from 'astro:assets';
import portrait from '../assets/jonathan-clausen.jpg';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import ContactForm from './ContactForm.astro';
import { t, prefix, type Lang } from '../i18n';
import { PROJECTS } from '../data/projects';
import { SITE } from '../data/site';
import { BLOG_POSTS } from '../data/blog';
import { POST_META } from '../data/posts-meta';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const p = prefix(lang);

const yearsExperience = new Date().getFullYear() - SITE.freelanceSince;
const companiesCount = 8;
const icons = [
  'M9.75 8.25 6 12l3.75 3.75M14.25 8.25 18 12l-3.75 3.75',
  'M12 3 3 7.5l9 4.5 9-4.5L12 3ZM3 12l9 4.5 9-4.5M3 16.5l9 4.5 9-4.5',
  'M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z',
  'M3.75 3v18h18M8.25 15.75V18M12.75 11.25V18M17.25 6.75V18',
  'M12 4.5v3M12 16.5v3M4.5 12h3M16.5 12h3M6.5 6.5l2 2M15.5 15.5l2 2M6.5 17.5l2-2M15.5 8.5l2-2',
  'M2.25 3h1.5l1.5 12.75h13.5L20.25 8.25H5.25M9 20.25a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM17.25 20.25a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z',
];
const posts = [...BLOG_POSTS[lang]].sort((a, b) => POST_META[b.slug].published.localeCompare(POST_META[a.slug].published));
const dateFmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'da-DK', { day: 'numeric', month: 'short', year: 'numeric' });
---

<!-- Hero -->
<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-slate-50 dark:bg-slate-950" aria-hidden="true">
    <div class="animate-float absolute -top-32 -left-24 size-96 rounded-full bg-violet-400/30 blur-3xl dark:bg-violet-600/20"></div>
    <div class="animate-float-slow absolute -top-16 right-0 size-96 rounded-full bg-cyan-400/30 blur-3xl dark:bg-cyan-500/20"></div>
  </div>
  <div class="mx-auto max-w-5xl px-4 pt-20 pb-20 text-center sm:px-6 sm:pt-24">
    <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-4 py-1.5 text-xs font-semibold text-slate-600 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
      <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
      {tr.hero.eyebrow}
    </p>
    <h1 id="hero-title" class="mt-6 font-display text-4xl font-bold leading-[1.1] tracking-tight text-slate-900 sm:text-6xl dark:text-white">
      <span class="bg-gradient-to-r from-violet-600 via-fuchsia-500 to-cyan-500 bg-clip-text text-transparent">{tr.hero.title}</span>
    </h1>
    <p class="mt-3 font-display text-lg font-medium text-slate-500 sm:text-xl dark:text-slate-400">{tr.hero.subtitle}</p>
    <p class="mx-auto mt-6 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">{tr.hero.description}</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a href="#contact" class="rounded-full bg-gradient-to-r from-violet-600 to-cyan-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-violet-500/30">{tr.hero.cta}</a>
      <a href="#competencies" class="rounded-full border border-slate-300 px-7 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5">{tr.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<!-- Competencies -->
<section id="competencies" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-20 sm:px-6" aria-labelledby="competencies-title">
  <SectionHeading id="competencies-title" eyebrow={tr.competencies.subheading} title={tr.competencies.heading} />
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {tr.competencies.items.map((item, i) => (
      <div class="rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-violet-300 hover:shadow-xl hover:shadow-violet-500/10 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-violet-500/40">
        <div class="grid size-11 place-items-center rounded-xl bg-gradient-to-br from-violet-600 to-cyan-500 text-white shadow-md shadow-violet-500/25" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5.5"><path stroke-linecap="round" stroke-linejoin="round" d={icons[i]} /></svg>
        </div>
        <h3 class="mt-4 font-display font-semibold text-slate-900 dark:text-white">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{item.description}</p>
      </div>
    ))}
  </div>
</section>

<!-- Cases -->
<section id="cases" class="scroll-mt-20 border-y border-slate-200 bg-slate-50 transition-colors dark:border-white/10 dark:bg-white/[0.02]" aria-labelledby="cases-title">
  <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <SectionHeading id="cases-title" eyebrow={tr.caseStudies.heading} title={tr.caseStudies.subheading} />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {PROJECTS.map((project, i) => (
        <ProjectCard project={project} text={tr.caseStudies.items[i]} readMore={tr.caseStudies.readMore} />
      ))}
    </div>
  </div>
</section>

<!-- Career -->
<section id="career" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-20 sm:px-6" aria-labelledby="career-title">
  <SectionHeading id="career-title" eyebrow={tr.timeline.heading} title={tr.timeline.subheading} />
  <ol class="relative ml-3 border-l border-slate-200 dark:border-white/10">
    {tr.timeline.items.map((item) => (
      <li class="relative pb-10 pl-8 last:pb-0">
        <span class:list={['absolute top-1 -left-[7px] size-3.5 rounded-full border-2 border-white dark:border-slate-950', item.current ? 'bg-violet-500' : 'bg-slate-300 dark:bg-slate-600']} aria-hidden="true"></span>
        <h3 class="font-display font-semibold text-slate-900 dark:text-white">{item.role} <span class="font-sans font-normal text-slate-600 dark:text-slate-300">&middot; {item.company}</span></h3>
        <p class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-slate-500 dark:text-slate-400">
          <span>{item.date}</span><span aria-hidden="true">&middot;</span><span>{item.location}</span>
          {item.current && <span class="rounded-full bg-violet-100 px-2 py-0.5 font-medium text-violet-700 dark:bg-violet-500/15 dark:text-violet-300">{tr.timeline.currentLabel}</span>}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{item.description}</p>
      </li>
    ))}
  </ol>
</section>

<!-- About -->
<section class="border-t border-slate-200 dark:border-white/10" aria-labelledby="about-title">
  <div class="mx-auto grid max-w-5xl items-start gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[auto_1fr]">
    <div class="flex justify-center lg:justify-start">
      <div class="relative">
        <div class="absolute -inset-3 rounded-full bg-gradient-to-br from-violet-600 to-cyan-500 opacity-30 blur-2xl" aria-hidden="true"></div>
        <Image src={portrait} alt={`Portræt af ${tr.about.name}`} width={256} height={256} class="relative size-32 rounded-full object-cover shadow-xl ring-4 ring-white dark:ring-slate-950" />
      </div>
    </div>
    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-widest text-violet-600 dark:text-violet-400">{tr.about.heading}</p>
      <h2 id="about-title" class="mt-2 font-display text-2xl font-bold text-slate-900 dark:text-white">{tr.about.name}</h2>
      <p class="font-medium text-slate-500 dark:text-slate-400">{tr.about.role}</p>
      <div class="mt-5 max-w-2xl space-y-4 leading-relaxed text-slate-600 dark:text-slate-300">
        {tr.about.text.map((para) => <p>{para}</p>)}
      </div>
      <dl class="mt-8 grid max-w-md grid-cols-3 gap-4 border-t border-slate-200 pt-6 dark:border-white/10">
        <div class="flex flex-col-reverse"><dt class="mt-1 text-xs text-slate-500 dark:text-slate-400">{tr.about.statYears}</dt><dd class="font-display text-2xl font-bold text-slate-900 dark:text-white">{yearsExperience}+</dd></div>
        <div class="flex flex-col-reverse"><dt class="mt-1 text-xs text-slate-500 dark:text-slate-400">{tr.about.statCompanies}</dt><dd class="font-display text-2xl font-bold text-slate-900 dark:text-white">{companiesCount}+</dd></div>
        <div class="flex flex-col-reverse"><dt class="mt-1 text-xs text-slate-500 dark:text-slate-400">{tr.about.statSince}</dt><dd class="font-display text-2xl font-bold text-slate-900 dark:text-white">{SITE.freelanceSince}</dd></div>
      </dl>
    </div>
  </div>
</section>

<!-- Latest posts -->
<section class="border-t border-slate-200 bg-slate-50 dark:border-white/10 dark:bg-white/[0.02]" aria-labelledby="posts-title">
  <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <SectionHeading id="posts-title" eyebrow={tr.nav.blog} title={tr.blog.heading} />
    <div class="grid gap-5 md:grid-cols-3">
      {posts.map((post) => (
        <article class="relative rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-violet-500/10 dark:border-white/10 dark:bg-white/[0.03]">
          <p class="text-xs text-slate-500 dark:text-slate-400"><time datetime={POST_META[post.slug].published}>{dateFmt.format(new Date(POST_META[post.slug].published))}</time></p>
          <h3 class="mt-2 font-display font-semibold text-slate-900 dark:text-white"><a href={`${p}/blog/${post.slug}/`} class="after:absolute after:inset-0">{post.title}</a></h3>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Contact -->
<section id="contact" class="relative scroll-mt-20 overflow-hidden border-t border-slate-200 dark:border-white/10" aria-labelledby="contact-title">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-slate-50 dark:bg-slate-950" aria-hidden="true">
    <div class="absolute bottom-0 left-1/2 size-[32rem] -translate-x-1/2 rounded-full bg-violet-400/20 blur-3xl dark:bg-violet-600/10"></div>
  </div>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <h2 id="contact-title" class="font-display text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">{tr.contact.heading}</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      {lang === 'en' ? 'Email me at' : 'Skriv til'} <a class="font-medium text-violet-600 underline underline-offset-4 dark:text-violet-400" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {lang === 'en' ? ' or call ' : ' eller ring på '}<a class="font-medium text-violet-600 underline underline-offset-4 dark:text-violet-400" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>.
    </p>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{tr.contact.orForm}</p>
    <ContactForm lang={lang} />
  </div>
</section>
