---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROJECTS } from '../../data/projects';
import { breadcrumbs } from '../../lib/schema';
import { t } from '../../i18n';

const tr = t('da');
const crumbs = [{ name: 'Forside', path: '/' }, { name: 'Cases', path: '/project/' }];
---
<Base title="Cases: udvalgte freelanceprojekter | Concensur"
      description="Udvalgte freelanceprojekter fra Concensur: WooCommerce-webshops, WordPress-hjemmesider, ERP-integrationer og SEO for danske og internationale kunder."
      path="/project/" lang="da" jsonLd={[breadcrumbs(crumbs)]}>
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 font-display text-4xl font-bold text-slate-900 dark:text-white">Cases</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">{tr.caseStudies.subheading}: webshops, hjemmesider og integrationer bygget siden 2019.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {PROJECTS.map((project) => <ProjectCard project={project} readMore={tr.caseStudies.readMore} headingLevel="h2" />)}
    </div>
  </div>
</Base>
