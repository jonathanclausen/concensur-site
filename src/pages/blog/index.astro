---
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../data/categories';
import { breadcrumbs } from '../../lib/schema';
import { t } from '../../i18n';

const tr = t('da');
const crumbs = [{ name: 'Forside', path: '/' }, { name: 'Blog', path: '/blog/' }];
---
<Base title={tr.seo.blogTitle} description={tr.seo.blogDescription} path="/blog/" lang="da"
      alternates={[{ lang: 'da', path: '/blog/' }, { lang: 'en', path: '/en/blog/' }]}
      jsonLd={[breadcrumbs(crumbs)]}>
  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 font-display text-4xl font-bold text-slate-900 dark:text-white">Blog</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">{tr.seo.blogDescription}</p>
    <nav aria-label="Kategorier" class="mt-6 flex flex-wrap gap-2">
      {Object.entries(CATEGORIES).map(([slug, c]) => (
        <a href={`/blog/category/${slug}/`} class="rounded-full border border-slate-200 px-3 py-1 text-sm text-slate-600 hover:border-violet-400 hover:text-violet-700 dark:border-white/10 dark:text-slate-300 dark:hover:text-violet-300">{c.name}</a>
      ))}
    </nav>
    <div class="mt-10"><BlogList lang="da" /></div>
  </div>
</Base>
