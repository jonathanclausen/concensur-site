---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { t } from '../../i18n';
import { person, business, website } from '../../lib/schema';

const tr = t('en');
---
<Base title={tr.seo.homeTitle} description={tr.seo.homeDescription} path="/en/" lang="en"
      alternates={[{ lang: 'da', path: '/' }, { lang: 'en', path: '/en/' }]}
      jsonLd={[website(), person(), business()]}>
  <Home lang="en" />
</Base>
